# Copy to ".env" for local development. NEVER commit the real file.
#
# Your Hevy API key (Hevy app -> Settings -> API). Used only at build/sync time
# to pull your data. It is never shipped to the browser.
HEVY_API_KEY=your-hevy-api-key-here

# The passphrase that protects your dashboard. The synced data is encrypted with
# this at build time and decrypted in the browser when you enter it. Pick a long,
# strong passphrase — the encrypted blob is publicly hosted.
DASHBOARD_PASSWORD=choose-a-strong-passphrase

# Optional: base path for the deployed site. Defaults to "/workoutreport/".
# Set to "/" if you use a custom domain or the user.github.io root repo.
# BASE_PATH=/workoutreport/
